# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=your_app_key_here

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cloudstore
DB_USERNAME=root
DB_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=cloudstore:

# Storage
STORAGE_DRIVER=local
STORAGE_PATH=storage/uploads

# Payment
PAYMENT_PROVIDER=fake
PAYMENT_KEY=
PAYMENT_SECRET=replace_with_the_gateway_webhook_secret

# JWT
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_TTL=86400

# Logging
LOG_LEVEL=debug
LOG_CHANNEL=file

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=60
