# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
# Public HTTPS origin embedded into customer and driver app builds. It must be
# reachable from customers' phones; never use localhost or a private LAN IP.
MOBILE_API_ORIGIN=https://market.cloudkart24.com
APP_KEY=your_app_key_here

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cloudstore
DB_USERNAME=root
DB_PASSWORD=

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=cloudstore:

# Storage
STORAGE_DRIVER=local
STORAGE_PATH=storage/uploads

# Payment
PAYMENT_PROVIDER=fake
PAYMENT_KEY=
PAYMENT_SECRET=replace_with_the_gateway_webhook_secret

# JWT
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_TTL=86400

# OTP delivery relay (SMS/WhatsApp provider credentials should live in the relay)
OTP_WEBHOOK_URL=
OTP_WEBHOOK_TOKEN=

# Logging
LOG_LEVEL=debug
LOG_CHANNEL=file

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=60

# GitHub Actions (for app builds)
GITHUB_TOKEN=
GITHUB_REPO=Astra-Techno/cloudstore
BUILD_WEBHOOK_SECRET=
